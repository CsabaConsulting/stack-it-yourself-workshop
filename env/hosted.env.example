# Hosted fallback - use ONLY if your local model will not run.
#
#   1. Copy this file to env/hosted.env
#   2. Fill in an OpenAI-compatible endpoint, key and model name
#      (from your workshop instructors, or your own provider)
#   3. Carry on with the workshop exactly as everyone else does
#
# This file overrides the model settings in every step, so you never edit it again.
# env/hosted.env is git-ignored - never commit a key.
#
# Pick the prefix for the API surface your endpoint actually speaks:
#   openai-chat:       Chat Completions - works almost everywhere (the safe default)
#   openai-responses:  Responses API    - only if the endpoint supports it
# Some hosted model catalogs speak Chat Completions but not the Responses API, and answer
# Responses requests with HTTP 400. Step 2 shows why that matters.
MODEL=openai-chat:your-model-name
OPENAI_BASE_URL=https://your-endpoint.example.com/v1
OPENAI_API_KEY=your-api-key
# Many hosted services don't accept a reasoning-effort parameter, so send none.
REASONING=default
