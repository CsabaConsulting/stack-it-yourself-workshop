# Step 1 - Baseline: an agent on open inference.
#   Chat Completions via Ollama (OllamaModel) | history in process memory | telemetry off | no tools
COMPOSE_PROFILES=
MODEL=ollama:qwen3:1.7b
OPENAI_BASE_URL=http://ollama:11434/v1
OPENAI_API_KEY=ollama
REASONING=off
OTEL_SDK_DISABLED=true
CAPTURE_CONTENT=true
HISTORY_BACKEND=memory
TOOLS=
