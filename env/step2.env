# Step 2 - Same server, modern API.
#   One line changes: the model prefix. openai-responses: -> OpenAIResponsesModel -> Responses API,
#   still pointed at the same local Ollama.
COMPOSE_PROFILES=
MODEL=openai-responses:qwen3:1.7b
OPENAI_BASE_URL=http://ollama:11434/v1
OPENAI_API_KEY=ollama
REASONING=off
OTEL_SDK_DISABLED=true
CAPTURE_CONTENT=true
HISTORY_BACKEND=memory
TOOLS=
