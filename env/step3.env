# Step 3 - Observability.
#   Start the LGTM stack and switch the OpenTelemetry SDK on. The instrumentation line in the
#   agent has been there since Step 1; now it has somewhere to send spans, metrics and logs.
COMPOSE_PROFILES=observability
MODEL=openai-responses:qwen3:1.7b
OPENAI_BASE_URL=http://ollama:11434/v1
OPENAI_API_KEY=ollama
REASONING=off
OTEL_SDK_DISABLED=false
CAPTURE_CONTENT=true
HISTORY_BACKEND=memory
TOOLS=
