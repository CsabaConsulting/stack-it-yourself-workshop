# Step 5 - Tools, in-process and over MCP.
#   Start the MCP server and give the agent both kinds of tool. One trace now spans two processes.
COMPOSE_PROFILES=observability,state,tools
MODEL=openai-responses:qwen3:1.7b
OPENAI_BASE_URL=http://ollama:11434/v1
OPENAI_API_KEY=ollama
REASONING=off
OTEL_SDK_DISABLED=false
CAPTURE_CONTENT=true
HISTORY_BACKEND=redis
TOOLS=local,mcp
